<schemalist gettext-domain="gnome-shell-extension-crypto-tracker">
  <schema
      id="org.gnome.shell.extensions.crypto-tracker"
      path="/org/gnome/shell/extensions/crypto-tracker/">
    <key
        type="s"
        name="coins">
      <default>'{"coins":[{"id": "xxxx-xxxx-xxx-xxx1", "symbol":"BTC/USDT", "active": true, "title":"BTC","exchange":"Binance", "coingecko_id": ""}]}'</default>
      <description />
    </key>
    <key
        type='s'
        name='exchange'>
      <default>'Binance'</default>
    </key>
    <key type="i" name="refresh-interval">
      <default>15</default>
      <summary>Seconds between price refreshes</summary>
      <description>Lower bound. Each source also has its own minimum.</description>
    </key>
    <key type="s" name="chart-style">
      <default>'gradient-fill'</default>
      <summary>Sparkline renderer id</summary>
    </key>
    <key type="s" name="base-currency">
      <default>''</default>
      <summary>Fiat currency the portfolio total is shown in</summary>
      <description>Empty means not yet configured; the portfolio shows a picker.</description>
    </key>
    <key type="b" name="portfolio-view">
      <default>false</default>
      <summary>Show holdings and a total instead of plain prices</summary>
    </key>
  </schema>
</schemalist>